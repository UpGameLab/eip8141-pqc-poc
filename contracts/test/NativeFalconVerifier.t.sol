pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {NativeFalconVerifier} from "../src/example/falcon/NativeFalconVerifier.sol";

contract NativeFalconVerifierTest is Test {
    event GasMeasured(uint256 gasUsed);

    NativeFalconVerifier internal verifier;

    function setUp() public {
        verifier = new NativeFalconVerifier();
    }

    function test_verifyNISTKAT() public {
        assertTrue(verifier.verify(_signature(), _publicKey(), _challenge()));
    }

    function test_verifyNISTKATGas() public {
        bytes memory signature = _signature();
        bytes memory publicKey = _publicKey();
        bytes memory challenge = _challenge();

        uint256 gasBefore = gasleft();
        bool valid = verifier.verify(signature, publicKey, challenge);
        uint256 gasUsed = gasBefore - gasleft();

        emit GasMeasured(gasUsed);
        assertTrue(valid);
    }

    function test_rejectsMalformedChallenge() public {
        bytes memory challenge = _challenge();
        challenge[0] = 0xff;
        challenge[1] |= 0xfc;
        assertFalse(verifier.verify(_signature(), _publicKey(), challenge));
    }

    // NIST Falcon-512 KAT vector 0, converted to the padded repository ABI.
    function _publicKey() internal pure returns (bytes memory) {
        return hex"";
    }

    function _signature() internal pure returns (bytes memory) {
        return hex"";
    }

    function _challenge() internal pure returns (bytes memory) {
        return hex"";
    }
}
